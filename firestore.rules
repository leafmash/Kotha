rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }
    function hasBlocked(owner, target) {
      return exists(/databases/$(database)/documents/users/$(owner)/blocked/$(target));
    }
    function isDirect(chat) {
      return chat.get('group', false) != true && chat.members.size() == 2;
    }
    function otherMember(chat) {
      return chat.members[0] == request.auth.uid ? chat.members[1] : chat.members[0];
    }
    function blockedByOther(chat) {
      return isDirect(chat) && hasBlocked(otherMember(chat), request.auth.uid);
    }
    function blockedEitherWay(chat) {
      return isDirect(chat) && (hasBlocked(otherMember(chat), request.auth.uid) || hasBlocked(request.auth.uid, otherMember(chat)));
    }
    function validCallLog(chatId) {
      let d = request.resource.data;
      let log = d.callLog;
      let call = get(/databases/$(database)/documents/calls/$(log.callId)).data;
      return d.type == 'call'
        && d.text == ''
        && log is map
        && log.keys().hasOnly(['kind', 'video', 'secs', 'callId'])
        && log.kind in ['done', 'declined', 'cancelled', 'missed']
        && log.video is bool
        && log.secs is int
        && log.secs >= 0
        && log.secs < 86400
        && log.callId is string
        && call.caller == request.auth.uid
        && call.chatId == chatId;
    }
    function adminOf(c) {
      return c.get('admin', '') == request.auth.uid || request.auth.uid in c.get('admins', []);
    }
    function validSysLog(chatId) {
      let d = request.resource.data;
      let s = d.sys;
      let c = chatDoc(chatId);
      return d.type == 'system'
        && d.text == ''
        && s is map
        && s.keys().hasOnly(['kind', 'by', 'names', 'target', 'name'])
        && s.keys().hasAll(['kind'])
        && s.kind in ['added', 'removed', 'left', 'renamed', 'promoted', 'demoted', 'photo', 'desc']
        && c.get('group', false) == true
        && (s.kind == 'left' || adminOf(c));
    }
    function leavesGroup() {
      let o = resource.data;
      let n = request.resource.data;
      let rest = o.get('admins', []).removeAll([request.auth.uid]);
      return o.get('group', false) == true
        && n.members == o.members.removeAll([request.auth.uid])
        && n.diff(o).affectedKeys().hasOnly(['members', 'admins', 'admin'])
        && n.get('admins', []).hasAll(rest)
        && n.get('admins', []).hasOnly(n.members)
        && n.get('admins', []).size() <= rest.size() + 1
        && (n.get('admin', '') == o.get('admin', '') || (o.get('admin', '') == request.auth.uid && n.get('admin', '') in n.members))
        && (n.get('admins', []).size() <= rest.size() || adminOf(o));
    }
    function groupMetaOk() {
      let o = resource.data;
      let n = request.resource.data;
      let changed = n.diff(o).affectedKeys();
      return o.get('group', false) != true
        || !changed.hasAny(['name', 'description', 'photo', 'admin', 'admins', 'adminOnly', 'group'])
        || (adminOf(o)
          && !changed.hasAny(['admin', 'group'])
          && n.get('name', '') is string
          && n.get('name', '').size() > 0
          && n.get('name', '').size() <= 40
          && n.get('description', '') is string
          && n.get('description', '').size() <= 300
          && n.get('photo', '') is string
          && n.get('photo', '').size() <= 600
          && n.get('adminOnly', false) is bool
          && n.get('admins', []).hasOnly(n.members));
    }
    function membersChangeOk() {
      let o = resource.data;
      let n = request.resource.data;
      return n.members == o.members
        || (o.get('group', false) == true
          && adminOf(o)
          && n.members.toSet().size() == n.members.size()
          && n.members.size() <= 256
          && n.members.size() >= 1
          && (n.members.hasAll(o.members)
            || (o.members.hasAll(n.members)
              && (!('admin' in o) || o.admin in n.members))));
    }
    function ownReadReset() {
      let o = resource.data;
      let n = request.resource.data;
      return n.diff(o).affectedKeys().hasOnly(['unread', 'readAt'])
        && n.get('unread', {}).diff(o.get('unread', {})).affectedKeys().hasOnly([request.auth.uid])
        && n.get('unread', {})[request.auth.uid] == 0
        && n.get('readAt', {}).diff(o.get('readAt', {})).affectedKeys().hasOnly([request.auth.uid])
        && n.get('readAt', {})[request.auth.uid] == request.time;
    }
    function ownDelete() {
      let o = resource.data;
      let n = request.resource.data;
      return o.from == request.auth.uid
        && n.diff(o).affectedKeys().hasOnly(['deleted', 'text', 'url'])
        && n.deleted == true
        && n.text == ''
        && n.get('url', '') == '';
    }
    function ownEdit() {
      let o = resource.data;
      let n = request.resource.data;
      return o.from == request.auth.uid
        && o.get('type', 'text') == 'text'
        && o.get('deleted', false) != true
        && !('callLog' in o)
        && !('sys' in o)
        && n.diff(o).affectedKeys().hasOnly(['text', 'edited', 'editedAt'])
        && n.text is string
        && n.text.size() > 0
        && n.text.size() <= 5000
        && n.edited == true
        && n.editedAt == request.time
        && request.time < o.at + duration.value(15, 'm');
    }
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
      match /clears/{chatId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is timestamp;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
      match /blocked/{blockedId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && blockedId != userId
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is timestamp;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter', 'type', 'reason', 'note', 'reportedUid', 'chatId', 'messageId', 'content', 'contentType', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporter', 'type', 'reason', 'chatId', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.type in ['user', 'message', 'group']
        && request.resource.data.reason in ['spam', 'harassment', 'hate', 'sexual', 'violence', 'scam', 'other']
        && request.resource.data.chatId is string
        && isMember(request.resource.data.chatId)
        && (!('reportedUid' in request.resource.data) || (request.resource.data.reportedUid is string && request.resource.data.reportedUid != request.auth.uid))
        && (!('messageId' in request.resource.data) || request.resource.data.messageId is string)
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 2000))
        && (!('contentType' in request.resource.data) || (request.resource.data.contentType is string && request.resource.data.contentType.size() <= 20))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /emailLookup/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /pushTokens/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    function inCall(callId) {
      let c = get(/databases/$(database)/documents/calls/$(callId)).data;
      return signedIn() && (c.caller == request.auth.uid || c.callee == request.auth.uid);
    }
    match /calls/{callId} {
      allow read: if signedIn()
        && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.caller == request.auth.uid
        && request.resource.data.callee is string
        && request.resource.data.callee != request.auth.uid
        && request.resource.data.status == 'ringing'
        && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members.hasAll([request.auth.uid, request.resource.data.callee])
        && !hasBlocked(request.resource.data.callee, request.auth.uid)
        && !hasBlocked(request.auth.uid, request.resource.data.callee)
        && request.resource.data.keys().hasOnly(['caller', 'callee', 'chatId', 'video', 'status', 'offer', 'createdAt']);
      allow update: if signedIn()
        && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid)
        && request.resource.data.caller == resource.data.caller
        && request.resource.data.callee == resource.data.callee
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'endedAt', 'endReason', 'cam', 'secs'])
        && (!('secs' in request.resource.data) || (request.resource.data.secs is int && request.resource.data.secs >= 0 && request.resource.data.secs < 86400));
      match /candidates/{candId} {
        allow read: if inCall(callId);
        allow create: if inCall(callId) && request.resource.data.from == request.auth.uid;
      }
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && ((!blockedByOther(resource.data) && (leavesGroup() || (groupMetaOk() && membersChangeOk())))
          || ownReadReset());
      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.from == request.auth.uid
          && !blockedEitherWay(chatDoc(chatId))
          && (chatDoc(chatId).get('group', false) != true || !chatDoc(chatId).get('adminOnly', false) || adminOf(chatDoc(chatId)) || request.resource.data.get('type', 'text') == 'system')
          && (('callLog' in request.resource.data)
            ? validCallLog(chatId)
            : (('sys' in request.resource.data)
              ? validSysLog(chatId)
              : (request.resource.data.get('type', 'text') != 'call' && request.resource.data.get('type', 'text') != 'system')));
        allow update: if isMember(chatId)
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reactions', 'hiddenFor'])
            || ownDelete()
            || ownEdit());
      }
    }
  }
}
