rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }
    match /pushTokens/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId) && request.resource.data.from == request.auth.uid;
        allow update: if isMember(chatId)
          && (resource.data.from == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reactions']));
      }
    }
  }
}
