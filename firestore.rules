rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }
    function hasBlocked(owner, target) {
      return exists(/databases/$(database)/documents/users/$(owner)/blocked/$(target));
    }
    function isDirect(chat) {
      return chat.get('group', false) != true && chat.members.size() == 2;
    }
    function otherMember(chat) {
      return chat.members[0] == request.auth.uid ? chat.members[1] : chat.members[0];
    }
    function blockedByOther(chat) {
      return isDirect(chat) && hasBlocked(otherMember(chat), request.auth.uid);
    }
    function blockedEitherWay(chat) {
      return isDirect(chat) && (hasBlocked(otherMember(chat), request.auth.uid) || hasBlocked(request.auth.uid, otherMember(chat)));
    }
    function leavesGroup() {
      return resource.data.get('group', false) == true
        && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
      match /blocked/{blockedId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && blockedId != userId
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is timestamp;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter', 'type', 'reason', 'note', 'reportedUid', 'chatId', 'messageId', 'content', 'contentType', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporter', 'type', 'reason', 'chatId', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.type in ['user', 'message', 'group']
        && request.resource.data.reason in ['spam', 'harassment', 'hate', 'sexual', 'violence', 'scam', 'other']
        && request.resource.data.chatId is string
        && isMember(request.resource.data.chatId)
        && (!('reportedUid' in request.resource.data) || (request.resource.data.reportedUid is string && request.resource.data.reportedUid != request.auth.uid))
        && (!('messageId' in request.resource.data) || request.resource.data.messageId is string)
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 2000))
        && (!('contentType' in request.resource.data) || (request.resource.data.contentType is string && request.resource.data.contentType.size() <= 20))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /emailLookup/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /pushTokens/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    function inCall(callId) {
      let c = get(/databases/$(database)/documents/calls/$(callId)).data;
      return signedIn() && (c.caller == request.auth.uid || c.callee == request.auth.uid);
    }
    match /calls/{callId} {
      allow read: if signedIn()
        && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.caller == request.auth.uid
        && request.resource.data.callee is string
        && request.resource.data.callee != request.auth.uid
        && request.resource.data.status == 'ringing'
        && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members.hasAll([request.auth.uid, request.resource.data.callee])
        && !hasBlocked(request.resource.data.callee, request.auth.uid)
        && !hasBlocked(request.auth.uid, request.resource.data.callee)
        && request.resource.data.keys().hasOnly(['caller', 'callee', 'chatId', 'video', 'status', 'offer', 'createdAt']);
      allow update: if signedIn()
        && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid)
        && request.resource.data.caller == resource.data.caller
        && request.resource.data.callee == resource.data.callee
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'endedAt', 'endReason', 'cam', 'secs'])
        && (!('secs' in request.resource.data) || (request.resource.data.secs is int && request.resource.data.secs >= 0 && request.resource.data.secs < 86400));
      match /candidates/{candId} {
        allow read: if inCall(callId);
        allow create: if inCall(callId) && request.resource.data.from == request.auth.uid;
      }
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && !blockedByOther(resource.data)
        && (request.resource.data.members == resource.data.members || leavesGroup());
      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.from == request.auth.uid
          && !blockedEitherWay(chatDoc(chatId));
        allow update: if isMember(chatId)
          && (resource.data.from == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reactions', 'hiddenFor']));
      }
    }
  }
}
