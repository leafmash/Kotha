rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }
    match /emailLookup/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
    match /pushTokens/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    function inCall(callId) {
      let c = get(/databases/$(database)/documents/calls/$(callId)).data;
      return signedIn() && (c.caller == request.auth.uid || c.callee == request.auth.uid);
    }
    match /calls/{callId} {
      allow read: if signedIn()
        && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.caller == request.auth.uid
        && request.resource.data.callee is string
        && request.resource.data.callee != request.auth.uid
        && request.resource.data.status == 'ringing'
        && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members.hasAll([request.auth.uid, request.resource.data.callee])
        && request.resource.data.keys().hasOnly(['caller', 'callee', 'chatId', 'video', 'status', 'offer', 'createdAt']);
      allow update: if signedIn()
        && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid)
        && request.resource.data.caller == resource.data.caller
        && request.resource.data.callee == resource.data.callee
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status', 'endedAt', 'endReason', 'cam']);
      match /candidates/{candId} {
        allow read: if inCall(callId);
        allow create: if inCall(callId) && request.resource.data.from == request.auth.uid;
      }
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId) && request.resource.data.from == request.auth.uid;
        allow update: if isMember(chatId)
          && (resource.data.from == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reactions', 'hiddenFor']));
      }
    }
  }
}
