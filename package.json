{
  "name": "cova",
  "private": true,
  "version": "1.0.0",
  "description": "Cova — Bengali chat and calling app",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "resources": "python3 scripts/make-resources.py",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:www && npx cap sync android && npx capacitor-assets generate --android && python3 scripts/ci/inject-splash-theme.py"
  },
  "dependencies": {
    "firebase-admin": "^12.3.0"
  },
  "devDependencies": {
    "@capacitor-firebase/authentication": "^6.3.0",
    "@capacitor-firebase/messaging": "^6.3.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.1"
  }
}
